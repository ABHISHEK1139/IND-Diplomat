# =============================================================================
# Politiq AI — Background Worker
# Build context is the repository root:
#   docker build -f docker/Dockerfile.worker -t politiq-ai:worker .
# Run:    docker run --env-file .env politiq-ai:worker
# Polls the JSON job store and executes queued assessments (no web server).
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="DIP Team"
LABEL service="dip-worker"
LABEL role="worker"
LABEL description="Politiq AI Background Worker — job polling & pipeline execution (no web server)"

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# DIP 3 package layout: install the src/ tree plus the worker entry script.
COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir -e .
COPY scripts/analyst_worker.py scripts/analyst_worker.py

RUN mkdir -p /app/data
ENV DIP_DATA_DIR=/app/data

ENV PYTHONUNBUFFERED=1
HEALTHCHECK --interval=60s --timeout=10s --start-period=20s --retries=3 \
    CMD pgrep -f analyst_worker || exit 1
CMD ["python", "scripts/analyst_worker.py"]
