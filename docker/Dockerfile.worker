# =============================================================================
# DIP 2.0 — Background Worker — ~1.1 GB
# Build:  docker build -f Dockerfile.worker -t dip2-worker .
# Run:    docker run --env-file .env dip2-worker
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="DIP 2.0 Team"
LABEL service="dip2-worker"
LABEL role="worker"
LABEL description="DIP 2.0 Background Worker — job polling & pipeline execution (no web server)"

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Worker only needs: pipeline + job store (no FastAPI, no frontend, no dashboard)
COPY analyst_worker.py .
COPY analyst_api/ analyst_api/
COPY unified_pipeline.py .
COPY verifier.py .
COPY core/ core/
COPY Config/ Config/
COPY layer1_collection/ layer1_collection/
COPY layer2_knowledge/ layer2_knowledge/
COPY layer3_state/ layer3_state/
COPY layer3_world_model/ layer3_world_model/
COPY layer4_reasoning/ layer4_reasoning/
COPY layer10_telemetry/ layer10_telemetry/
COPY layer5_trajectory/ layer5_trajectory/
COPY layer6_presentation/ layer6_presentation/
COPY layer6_workspace/ layer6_workspace/
COPY layer6_backtesting/ layer6_backtesting/
COPY layer7_global/ layer7_global/
COPY layer8_wargaming/ layer8_wargaming/
COPY deliberation/ deliberation/
COPY decision/ decision/
COPY investigation/ investigation/
COPY memory/ memory/
COPY legal/ legal/
COPY SystemGuardian/ SystemGuardian/
COPY nextgen/ nextgen/
COPY ind_diplomat/ ind_diplomat/
COPY control_loop/ control_loop/

RUN mkdir -p /app/data

ENV PYTHONUNBUFFERED=1
HEALTHCHECK --interval=60s --timeout=10s --start-period=20s --retries=3 \
    CMD pgrep -f analyst_worker || exit 1
CMD ["python", "analyst_worker.py"]
