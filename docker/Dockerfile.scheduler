# =============================================================================
# DIP 2.0 — Data Ingestion Scheduler — ~600 MB
# Build:  docker build -f Dockerfile.scheduler -t dip2-scheduler .
# Run:    docker run --env-file .env dip2-scheduler
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="DIP 2.0 Team"
LABEL service="dip2-scheduler"
LABEL role="scheduler"
LABEL description="DIP 2.0 Scheduler — cron-based GDELT/ACLED/News polling (no web, no analysis)"

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl cron && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Scheduler only needs: orchestrator + Layer 1 & 2 + sensor deps
COPY orchestrator.py .
COPY layer1_collection/ layer1_collection/
COPY layer2_knowledge/ layer2_knowledge/
COPY core/ core/
COPY Config/ Config/

RUN mkdir -p /app/data

# Schedule: orchestrator every 6 hours, feed refresh every 30 min
RUN echo "0 */6 * * * cd /app && python orchestrator.py >> /tmp/scheduler.log 2>&1" > /tmp/crontab && \
    crontab /tmp/crontab

ENV PYTHONUNBUFFERED=1
HEALTHCHECK --interval=120s --timeout=10s --start-period=30s --retries=3 \
    CMD pgrep cron || exit 1
CMD ["cron", "-f"]
