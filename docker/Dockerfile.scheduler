# =============================================================================
# Politiq AI — Data Ingestion Scheduler
# Build context is the repository root:
#   docker build -f docker/Dockerfile.scheduler -t politiq-ai:scheduler .
# Run:    docker run --env-file .env politiq-ai:scheduler
# Cron-based Layer 1/2 ingestion via dip.orchestrator (no web, no analysis).
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="DIP Team"
LABEL service="dip-scheduler"
LABEL role="scheduler"
LABEL description="Politiq AI Scheduler — cron-based collection ingestion (no web, no analysis)"

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl cron && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# DIP 3 package layout: the orchestrator is dip.orchestrator in src/.
COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir -e .

RUN mkdir -p /app/data
ENV DIP_DATA_DIR=/app/data

# Schedule: orchestrator as a module every 6 hours.
RUN echo "0 */6 * * * cd /app && python -m dip.orchestrator >> /tmp/scheduler.log 2>&1" > /tmp/crontab && \
    crontab /tmp/crontab

ENV PYTHONUNBUFFERED=1
HEALTHCHECK --interval=120s --timeout=10s --start-period=30s --retries=3 \
    CMD pgrep cron || exit 1
CMD ["cron", "-f"]
