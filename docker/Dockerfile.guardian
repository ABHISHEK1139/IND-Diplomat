# =============================================================================
# DIP 2.0 — System Guardian — ~180 MB (lightweight!)
# Build:  docker build -f Dockerfile.guardian -t dip2-guardian .
# Run:    docker run --env-file .env dip2-guardian
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="DIP 2.0 Team"
LABEL service="dip2-guardian"
LABEL role="monitor"
LABEL description="DIP 2.0 System Guardian — health checks & auto-repair (NO LLM, NO pipeline)"

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl procps && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Guardian only needs: guardian_runner + SystemGuardian + Config
COPY guardian_runner.py .
COPY SystemGuardian/ SystemGuardian/
COPY Config/ Config/

RUN mkdir -p /app/data

ENV PYTHONUNBUFFERED=1
HEALTHCHECK --interval=60s --timeout=10s --start-period=20s --retries=3 \
    CMD pgrep -f guardian_runner || exit 1
CMD ["python", "guardian_runner.py"]

