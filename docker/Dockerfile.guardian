# =============================================================================
# Politiq AI — System Guardian (lightweight)
# Build context is the repository root:
#   docker build -f docker/Dockerfile.guardian -t politiq-ai:guardian .
# Run:    docker run --env-file .env politiq-ai:guardian
# Health checks & auto-repair (NO LLM, NO pipeline).
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="DIP Team"
LABEL service="dip-guardian"
LABEL role="monitor"
LABEL description="Politiq AI System Guardian — health checks & auto-repair (NO LLM, NO pipeline)"

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl procps && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# DIP 3 package layout: guardian runner plus the installed package.
COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir -e .
COPY scripts/guardian_runner.py scripts/guardian_runner.py

RUN mkdir -p /app/data
ENV DIP_DATA_DIR=/app/data

ENV PYTHONUNBUFFERED=1
HEALTHCHECK --interval=60s --timeout=10s --start-period=20s --retries=3 \
    CMD pgrep -f guardian_runner || exit 1
CMD ["python", "scripts/guardian_runner.py"]
