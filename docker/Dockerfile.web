# =============================================================================
# Politiq AI — Web Server (FastAPI + Uvicorn)
# Build context is the repository root:
#   docker build -f docker/Dockerfile.web -t politiq-ai:web .
# Run:    docker run -p 8000:8000 --env-file .env politiq-ai:web
# Serves: dip.api.rest_api:app (DIP 3 package layout under src/)
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="DIP Team"
LABEL service="dip-web"
LABEL role="api"
LABEL description="Politiq AI Web Server — FastAPI API + Prometheus /metrics"

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# DIP 3 package layout: install the src/ tree so `dip.*` imports resolve.
COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir -e .

RUN mkdir -p /app/data
ENV DIP_DATA_DIR=/app/data

EXPOSE 8000
ENV PYTHONUNBUFFERED=1
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1
# Single worker: the JSON job stores support exactly one API process.
# Scale out only after migrating to Postgres/Redis-backed stores.
CMD ["python", "-m", "uvicorn", "dip.api.rest_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
