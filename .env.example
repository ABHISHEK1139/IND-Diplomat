# =============================================================================
# DIP 2.0 — Environment Variables (copy to .env)
# =============================================================================

# ── LLM ────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o
LLM_PROVIDER=openai
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENAI_API_KEY=sk-your-key-here
OLLAMA_BASE_URL=http://localhost:11434

# ── Server ─────────────────────────────────────────────────────────
API_PORT=8000
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=*

# ── Data Providers ─────────────────────────────────────────────────
ACLED_API_KEY=
ACLED_EMAIL=
GDELT_API_KEY=

# ── Storage ────────────────────────────────────────────────────────
DIP_JOB_STORE=data/jobs.json
CHECKPOINT_DIR=data/checkpoints
CHROMA_DATA_DIR=data/chroma
MLFLOW_TRACKING_URI=file:./mlruns

# ── OSS Feature Flags (set to 1 to enable) ─────────────────────────
DIP_OTEL_ENABLED=0
DIP_MLFLOW_ENABLED=0
DIP_LANGGRAPH_ENABLED=0
DIP_PREFECT_ENABLED=0
DIP_STIX2_ENABLED=0
DIP_NETWORKX_ENABLED=0
DIP_HAYSTACK_ENABLED=0

# ── Runtime ────────────────────────────────────────────────────────
FORCE_MINISTER_HEURISTIC=0
LOG_LEVEL=INFO
LLM_TRACE_ENABLED=0

# ── Database (optional) ────────────────────────────────────────────
DATABASE_URL=
POSTGRES_USER=diplomat
POSTGRES_PASSWORD=
POSTGRES_DB=diplomat_db
REDIS_URL=
LLM_MODEL=gpt-4o

# Option 2: OpenRouter
# OPENROUTER_API_KEY=your-openrouter-key-here
# LLM_MODEL=openrouter/anthropic/claude-3-opus

# Option 3: Anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here
# LLM_MODEL=claude-3-5-sonnet-20240620

# --- PostgreSQL ---
POSTGRES_USER=diplomat
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=diplomat_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://diplomat:changeme_strong_password_here@db:5432/diplomat_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_LOG_LEVEL=info

# --- Security ---
SECRET_KEY=changeme_generate_a_random_64char_string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Observability ---
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
ENVIRONMENT=production
